{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Alpha Labs paper proposal v1",
  "required": [
    "account_id",
    "instrument",
    "strategy_id",
    "direction",
    "quantity",
    "stop_price",
    "idempotency_key"
  ],
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,100}$"
    },
    "instrument": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,100}$"
    },
    "strategy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,100}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:/-]{1,100}$"
    },
    "schema": {
      "const": "alpha-labs.paper.v1"
    },
    "direction": {
      "enum": [
        "LONG",
        "SHORT",
        "FLAT",
        "HALT",
        "UNSUPPORTED",
        "UNVERIFIED"
      ]
    },
    "quantity": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "stop_price": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "order_type": {
      "enum": [
        "market",
        "limit"
      ]
    },
    "limit_price": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "string",
              "maxLength": 40,
              "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
